*Heading
************************************************************************
** PARAMETERS (SI UNIT SYSTEM)
************************************************************************
*Parameter
** geometric parameters, element properties, and material ID
nDim        = 2
nStress     = 3
nNode       = 4
nInt        = 4
fbar        = 0
matID       = 1
nIons       = 2
nIonProps   = 5
matProps    = 15 + nIons*nIonProps
intProps    = 5
nstatev     = (nIons + 2)
nsvars      = nstatev*nInt
nPostVars   = 2*nStress + nstatev
**
** properties of rubber substrate
**
Grubber     = 66.0e3        
Krubber     = 100.0*Grubber
C10         = Grubber/2.0 
Drubber     = 2.0/Krubber
**
** physical constants and material properties
**
Rgas        = 8.3145
Fcon        = 96485.0
theta       = 298.0
phi0        = 0.10
rho         = 1100.0
Gshear      = 33.0e3
kappa       = 50.0*Gshear
pKa         = 5.0
Cp_fix      = 150.0
Vp          = 8.928e-3
Zp          = 1.0
mu0         = 0.0
Vw          = 1.8e-5
chi         = 0.40
Dw          = 9e-7
**
** properties of ions in gel
**
Cion1_gel   = 50.0
Cion2_gel   = 200.0
Omg0_1      = 0.
Omg0_2      = 0.
Vion_1      = 2.38e-6
Vion_2      = 2.24e-6
Zion_1      = 1.0
Zion_2      = -1.0
Dion_1      = 4.0e-8
Dion_2      = 4.0e-8
**
** initial conditions in gel (assuming zero electric potential and pressure)
**
RT          = Rgas*theta
Cw0_gel     = (1.0 - phi0)/Vw
**
initMU      = mu0 + RT*(phi0+log(1-phi0)+chi*phi0**2) - RT/Cw0_gel*(Cion1_gel + Cion2_gel)
initOmg1    = Omg0_1 + RT*log(Cion1_gel/Cw0_gel)
initOmg2    = Omg0_2 + RT*log(Cion2_gel/Cw0_gel)
**
** properties of ions in low salt solution
**
Cw_sol        = 55000.0
**
Cion1_sol     = 700.0
Cion2_sol     = 700.0
**
mu_sol        = mu0 - RT/Cw_sol*(Cion1_sol + Cion2_sol)
omg1_sol      = Omg0_1 + RT*log(Cion1_sol/Cw_sol)
omg2_sol      = Omg0_2 + RT*log(Cion2_sol/Cw_sol)
**
*************************************************************************
** time parameters
t_swell         = 3600.0*6.0
tRamp_swl       = 180.0
dtInit_swl      = 1.0e-3
dtMax_swl       = 300.0
**
dtMin           = 1.0e-15
**
************************************************************************
** GEOMETRY and MESH
************************************************************************
