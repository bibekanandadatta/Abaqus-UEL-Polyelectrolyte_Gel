*Heading
************************************************************************
** First run a free swelling simulation with a large plate_height
** Means deactivate the compression step
** Estimate the free swelling from the first run
** Make plate_height slightly smaller than free swelling height
** Compression step is likely to fail if plate is not in contact
** in the beginning of the compression step
************************************************************************
*Parameter
** geometric parameters, element properties, and material ID
nDim        = 2
nStress     = 4
nNode       = 4
nInt        = 4
fbar        = 0
matID       = 1
nIons       = 2
nIonProps   = 5
matProps    = 15 + nIons*nIonProps
intProps    = 5
nstatev     = (nIons + 2)
nsvars      = nstatev*nInt
nPostVars   = 2*nStress + nstatev
**
** physical constants and material properties
**
Rgas        = 8.3145
Fcon        = 96485.0
theta       = 298.0
phi0        = 0.31
rho         = 1100.0
Gshear      = 48.0e3
kappa       = 50.0*Gshear
pKa         = 5.0
Cp_fix      = 460.0
Vp          = 8.928e-3
Zp          = 1.0
mu0         = 0.0
Vw          = 1.8e-5
chi         = 0.40
Dw          = 9.0e-7
**
** properties of ions in gel
**
Cion1_gel   = 340.0
Cion2_gel   = 800.0
Omg0_1      = 0.
Omg0_2      = 0.
Vion_1      = 2.38e-6
Vion_2      = 2.24e-6
Zion_1      = 1.0
Zion_2      = -1.0
Dion_1      = 4.0e-8
Dion_2      = 4.0e-8
**
** initial conditions in gel (assuming zero electric potential and pressure)
**
RT          = Rgas*theta
Cw0_gel     = (1.0 - phi0)/Vw
**
initMU      = mu0 + RT*(phi0+log(1-phi0)+chi*phi0**2) - RT/Cw0_gel*(Cion1_gel + Cion2_gel)
initOmg1    = Omg0_1 + RT*log(Cion1_gel/Cw0_gel)
initOmg2    = Omg0_2 + RT*log(Cion2_gel/Cw0_gel)
**
** properties of ions in low salt solution
**
Cw_sol        = 55000.0
**
Cion1_sol     = 150.0
Cion2_sol     = 150.0
**
mu_sol        = mu0 - RT/Cw_sol*(Cion1_sol + Cion2_sol)
omg1_sol      = Omg0_1 + RT*log(Cion1_sol/Cw_sol)
omg2_sol      = Omg0_2 + RT*log(Cion2_sol/Cw_sol)
**
plate_height  = 4.41e-3
plate_length  = 12.5e-3
force         = 13.93
right_disp    = 3.66e-3
**
*************************************************************************
** time parameters
t_eql           = 1.0
tRamp_eql       = 0.1
dtInit_eql      = 1.0e-3
dtMax_eql       = 0.2
**
t_swell         = 1.0
tRamp_swl       = 0.1
dtInit_swl      = 1.0e-3
dtMax_swl       = 0.2
**
t_compress      = 12*3600.0
tRamp_comp      = 10.0
dtInit_comp     = 1.0e-6
dtMax_comp      = 300.0
**
dtMin           = 1.0e-15
**
************************************************************************
